# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_SUMMARIZER_MODEL=llama3.1

# ── Chroma (point to your existing ingestion pipeline output) ────────────────
CHROMA_PERSIST_DIR=../chroma_db
# comma-separated list for isolated multi-collection retrieval
CHROMA_COLLECTIONS=[]

# ── Embeddings — must match what you used in ingestion ───────────────────────

EMBEDDING_DEVICE=gpu

# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# ── Session storage ──────────────────────────────────────────────────────────
SQLITE_DB_PATH=../sessions/sessions.db

# ── Remote MCP server (SSE transport) ────────────────────────────────────────
# Leave REMOTE_MCP_URL blank to skip MCP tools gracefully
REMOTE_MCP_SERVERS=[]
REMOTE_MCP_URL=
REMOTE_MCP_TOKEN=
REMOTE_MCP_TENANT_ID=
# Multi-server JSON list (optional)
# REMOTE_MCP_SERVERS=[{"name":"remote","url":"http://localhost:8000/sse","transport":"sse"}]

# ── LLM provider routing ─────────────────────────────────────────────────────
LLM_PROVIDER=gemini
COORDINATOR_TEMPERATURE=0
SUMMARIZER_TEMPERATURE=0
ROUTER_TEMPERATURE=0

OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
ROUTER_MODEL=


# ── Graph control ─────────────────────────────────────────────────────────────
MAX_ITERATIONS=10
MAX_RETRIEVAL_ATTEMPTS=3
RETRIEVAL_K=5
